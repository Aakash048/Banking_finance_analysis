      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:transaction_type:nk]' type='palette'>
            <map to='#4e79a7'>
              <bucket>&quot;Debit&quot;</bucket>
            </map>
            <map to='#f28e2b'>
