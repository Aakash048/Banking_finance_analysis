      <aliases enabled='yes' />
      <column caption='Count_transaction' datatype='integer' name='[Calculation_0805033413152769]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([transaction_id])' />
      </column>
      <column caption='Avg_amount' datatype='real' name='[Calculation_0805033413574659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([amount_inr])' />
      </column>
      <column caption='Success Rate' datatype='real' default-format='p0.00%' name='[Calculation_0805033413734404]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([status]=&quot;SUCCESS&quot;,1,0)) / COUNT([transaction_id])' />
      </column>
      <column caption='Total_credit' datatype='real' name='[Calculation_0805033414275077]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [transaction_type] = &quot;Credit&quot;&#10;    THEN [amount_inr]&#10;    ELSE 0&#10;    END&#10;)' />
      </column>
      <column caption='Total_debit' datatype='real' name='[Calculation_0805033414426630]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [transaction_type] = &quot;Debit&quot;&#10;    THEN [amount_inr]&#10;    ELSE 0&#10;    END&#10;)' />
      </column>
      <column caption='Net Cash Flow' datatype='real' name='[Calculation_0805033414529031]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [transaction_type] = &quot;Credit&quot;&#10;    THEN [amount_inr]&#10;&#10;    ELSEIF [transaction_type] = &quot;Debit&quot;&#10;    THEN -[amount_inr]&#10;&#10;    ELSE 0&#10;    END&#10;)' />
      </column>
      <column caption='Total_Amount' datatype='real' default-format='n#,##0,,.00M;-#,##0,,.00M' name='[Calculation_5320658445275136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([amount_inr])' />
      </column>
